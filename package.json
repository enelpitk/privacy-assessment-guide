{
  "name": "dpia-guide",
  "version": "0.2.0",
  "private": true,
  "description": "DPIA Guide - guided Data Protection Impact Assessment demo (fictional data only)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "next": "15.5.29",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}
