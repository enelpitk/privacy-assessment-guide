# Copy to .env for local tooling only. Never commit .env.
# On Railway, DATABASE_URL is provided by the PostgreSQL service reference.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Optional, Railway only: set to "true" for ONE deploy to upsert the fictional demo users
# and departments at startup, then remove the variable. Never resets other data.
# RUN_SEED_USERS="true"
